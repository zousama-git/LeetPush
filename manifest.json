{
  "manifest_version": 3,
  "name": "LeetPush",
  "version": "1.1.0",
  "description": "Zero-click automated sync of LeetCode solutions to GitHub.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.github.com/*", "https://leetcode.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://leetcode.com/problems/*"], "js": ["content.js"] }
  ],
  "action": { "default_popup": "popup.html" }
}
